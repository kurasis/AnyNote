{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anynote:p13:content:v1",
  "$defs": {
    "export-request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "group_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "include_history": {
          "type": "boolean"
        },
        "include_trash": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "operation_id",
        "group_ids",
        "include_history",
        "include_trash"
      ],
      "additionalProperties": false
    },
    "renew-request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "export-result": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "$ref": "urn:anynote:p11:sync:v1#/$defs/scope"
        },
        "descriptor": {
          "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/snapshot-descriptor"
        },
        "catalog_count": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "catalog_digest": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/digest"
        },
        "lease_expires_at_ms": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "maximum_expires_at_ms": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "served_bytes": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "selection": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "operation_id": {
              "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
            },
            "group_ids": {
              "type": "array",
              "items": {
                "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
              },
              "maxItems": 1000,
              "uniqueItems": true
            },
            "include_history": {
              "type": "boolean"
            },
            "include_trash": {
              "type": "boolean"
            }
          },
          "required": [
            "version",
            "operation_id",
            "group_ids",
            "include_history",
            "include_trash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "scope",
        "descriptor",
        "catalog_count",
        "catalog_digest",
        "lease_expires_at_ms",
        "maximum_expires_at_ms",
        "served_bytes",
        "selection"
      ],
      "additionalProperties": false
    },
    "catalog-page": {
      "$ref": "urn:anynote:p11:sync:v1#/$defs/catalog-page"
    },
    "cancel-result": {
      "$ref": "urn:anynote:p11:sync:v1#/$defs/cancel-result"
    },
    "export-page-result": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "$ref": "urn:anynote:p11:sync:v1#/$defs/scope"
        },
        "page": {
          "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/snapshot-page"
        }
      },
      "required": [
        "version",
        "scope",
        "page"
      ],
      "additionalProperties": false
    },
    "export-record-result": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "snapshot_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "item": {
          "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/snapshot-item"
        },
        "record": {
          "oneOf": [
            {
              "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/bundle"
            },
            {
              "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/export-file-record"
            },
            {
              "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/export-pruned-record"
            }
          ]
        }
      },
      "required": [
        "version",
        "snapshot_id",
        "item",
        "record"
      ],
      "additionalProperties": false
    },
    "portable-evidence": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "p13-public-proof-v1"
        },
        "version": {
          "const": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "urn:anynote:p10:shared:v1#/$defs/adopt-request"
          },
          "maxItems": 200
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "urn:anynote:p10:shared:v1#/$defs/account-proof"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "profile",
        "version",
        "groups",
        "accounts"
      ],
      "additionalProperties": false
    },
    "export-header-item": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/snapshot-item"
        },
        "envelope": {
          "oneOf": [
            {
              "$ref": "urn:anynote:p02:complete-contract:v1#/$defs/envelope"
            },
            {
              "$ref": "urn:anynote:p02:file-contract:c1#/$defs/envelope"
            }
          ]
        },
        "record_bytes": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        }
      },
      "required": [
        "item",
        "envelope",
        "record_bytes"
      ],
      "additionalProperties": false
    },
    "export-header-page": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "snapshot_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "start": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/export-header-item"
          },
          "maxItems": 100
        },
        "next": {
          "anyOf": [
            {
              "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "snapshot_id",
        "start",
        "items",
        "next"
      ],
      "additionalProperties": false
    },
    "thumbnail-body": {
      "type": "object",
      "properties": {
        "purpose": {
          "const": "derived-thumbnail-link"
        },
        "version": {
          "const": 1
        },
        "service_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "group_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "operation_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "author": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/author"
        },
        "policy": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/policy"
        },
        "source_version_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "source_envelope_digest": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/digest"
        },
        "derived_version_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "derived_envelope_digest": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/digest"
        },
        "kind": {
          "const": "png-256"
        }
      },
      "required": [
        "purpose",
        "version",
        "service_id",
        "group_id",
        "operation_id",
        "author",
        "policy",
        "source_version_id",
        "source_envelope_digest",
        "derived_version_id",
        "derived_envelope_digest",
        "kind"
      ],
      "additionalProperties": false
    },
    "thumbnail-link": {
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/thumbnail-body"
        },
        "signature": {
          "type": "string",
          "format": "base64url-64"
        }
      },
      "required": [
        "body",
        "signature"
      ],
      "additionalProperties": false
    },
    "thumbnail-result": {
      "type": "object",
      "properties": {
        "group_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "operation_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "source_version_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "derived_version_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "version": {
          "const": 1
        },
        "digest": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/digest"
        },
        "state": {
          "const": "LINKED"
        }
      },
      "required": [
        "group_id",
        "operation_id",
        "source_version_id",
        "derived_version_id",
        "version",
        "digest",
        "state"
      ],
      "additionalProperties": false
    },
    "retention-request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "confirm": {
          "const": true
        },
        "after": {
          "oneOf": [
            {
              "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "confirm",
        "after"
      ],
      "additionalProperties": false
    },
    "retention-pin-request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "pinned"
      ],
      "additionalProperties": false
    },
    "retention-pin-result": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "group_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "revision_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "pinned": {
          "type": "boolean"
        },
        "payload_status": {
          "enum": [
            "retained",
            "pruned"
          ]
        }
      },
      "required": [
        "version",
        "group_id",
        "revision_id",
        "pinned",
        "payload_status"
      ],
      "additionalProperties": false
    },
    "retention-item": {
      "type": "object",
      "properties": {
        "revision_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "object_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "payload_status": {
          "enum": [
            "retained",
            "pruned"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "current-or-conflict-head",
              "explicit-retention-pin",
              "active-snapshot-or-export",
              "retained-trash",
              "latest-thirty-days",
              "daily-ninety-days",
              "monthly-history"
            ]
          }
        }
      },
      "required": [
        "revision_id",
        "object_id",
        "payload_status",
        "eligible",
        "reasons"
      ],
      "additionalProperties": false
    },
    "retention-result": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "group_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "mode": {
          "enum": [
            "report-only",
            "explicit-apply"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/retention-item"
          }
        },
        "next": {
          "oneOf": [
            {
              "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "released_ciphertext_bytes": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "signed_ancestry_retained": {
          "const": true
        },
        "physical_database_pages_reclaimed": {
          "const": false
        }
      },
      "required": [
        "version",
        "group_id",
        "mode",
        "items",
        "next",
        "released_ciphertext_bytes",
        "signed_ancestry_retained",
        "physical_database_pages_reclaimed"
      ],
      "additionalProperties": false
    }
  }
}
