      },
      "required": [
        "version",
        "group_id",
        "kind",
        "owner_account_id",
        "state",
        "membership",
        "key_epoch",
        "epoch_digest",
        "history_checkpoint_digest",
        "rekey_required",
        "history_closure_required",
        "restore_quarantined",
        "settings",
        "genesis"
