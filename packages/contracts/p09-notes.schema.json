        "created_sequence": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        },
        "updated_sequence": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        }
      },
      "required": [
        "object_id",
        "object_kind",
        "thread_id",
        "archived",
        "tombstoned",
        "heads",
        "created_sequence",
        "updated_sequence"
