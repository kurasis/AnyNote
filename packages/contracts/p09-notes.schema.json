    "revision-ref": {
      "type": "object",
      "properties": {
        "revision_id": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
        },
        "envelope_digest": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/digest"
        },
        "ciphertext_bytes": {
          "$ref": "urn:anynote:p02:file-contract:c1#/$defs/counter"
        }
      },
      "required": [
        "revision_id",
        "envelope_digest",
        "ciphertext_bytes"
