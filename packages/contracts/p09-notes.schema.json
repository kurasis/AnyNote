          "maxItems": 10000
        },
        "summary_entry_id": {
          "anyOf": [
            {
              "$ref": "urn:anynote:p02:file-contract:c1#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata_kind": {
          "enum": [
            "content",
            "account-preferences"
