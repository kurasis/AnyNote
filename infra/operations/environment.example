# Public configuration only. Secret VALUES belong in protected injected files.
ANYNOTE_PROJECT=anynote-reviewed-production
ANYNOTE_DEPLOY_ROOT=/srv/anynote/state
ANYNOTE_STATIC_ROOT=/srv/anynote-static/reviewed-release
ANYNOTE_API_IMAGE=REPLACE_WITH_REVIEWED_IMMUTABLE_IMAGE_DIGEST
ANYNOTE_UID=1000
ANYNOTE_GID=1000
ANYNOTE_BIND_IP=127.0.0.1
ANYNOTE_HTTPS_PORT=443
ANYNOTE_API_ISSUER=https://api.vault.example
ANYNOTE_APP_ORIGIN=https://app.vault.example
ANYNOTE_RP_ID=app.vault.example
ANYNOTE_SERVICE_ID=REPLACE_WITH_INDEPENDENT_SERVICE_ID
ANYNOTE_AGE=/opt/verified-tools/age
ANYNOTE_BACKUP_RECIPIENT=REPLACE_WITH_INDEPENDENT_PUBLIC_AGE_RECIPIENT
