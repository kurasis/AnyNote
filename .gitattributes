# Deterministic generated inputs on Linux and Windows; binary assets stay binary.
* text=auto eol=lf
# Preserve the supplied specification bytes exactly.
docs/spec/** -text
# Keep archived public receipts byte-identical to their downloaded artifact digests.
docs/evidence/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve exact upstream API-header bytes for SHA-256 and independent ABI checks.
experiments/p01/windows-hello/tests/hello/vendor/webauthn.h -text
# The P06 inventory hashes exact lock bytes on both Linux and Windows.
packages/auth-native/Cargo.lock -text

# P07 inventory hashes the exact reviewed bytes on Linux and MSVC.
packages/vault-native/Cargo.lock -text
