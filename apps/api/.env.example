APP_NAME=AnyNote
APP_ENV=local
APP_DEBUG=false
APP_URL=http://api.anynote.test:18080
# Framework key and disposable database passwords are generated in .local/p03.
# APP_KEY is never an application content-encryption key.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=anynote_synthetic
DB_USERNAME=anynote_dev
LOG_CHANNEL=null
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
